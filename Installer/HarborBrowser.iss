; Harbor Browser installer (Inno Setup 6+)
; The Build-Installer.ps1 script stages the compiled app and downloads Microsoft's
; signed offline .NET Framework 4.8 and WebView2 Evergreen installers.

#ifndef AppVersion
  #define VersionHandle FileOpen("..\VERSION.txt")
  #define AppVersion Trim(FileRead(VersionHandle))
  #call FileClose(VersionHandle)
#endif
#ifndef BuildRevision
  #define BuildRevision 0
#endif
#ifndef ReleaseSuffix
  #define ReleaseSuffix ""
#endif

#define AppName "Harbor Browser"
#define AppPublisher "Harbor Browser Project"
#define AppExeName "HarborBrowser.exe"
#define PayloadDir "..\dist\payload"
#define RedistDir "redist"
#ifndef BrowserRegistryRoot
  #define BrowserRegistryRoot "HKLM"
#endif
#ifndef BrowserClient
  #define BrowserClient "HarborBrowser"
#endif
#ifndef BrowserRegisteredName
  #define BrowserRegisteredName "Harbor Browser"
#endif

[Setup]
AppId={{8D9A0F4C-2E3B-4F64-9C12-8B3F1C0E74A1}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
DefaultDirName={autopf}\Harbor Browser
UsePreviousAppDir=yes
UsePreviousGroup=yes
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
UninstallDisplayName={#AppName}
UninstallDisplayIcon={app}\Branding\HarborBeacon-{#AppVersion}.ico
SetupIconFile=assets\HarborBrowser.ico
OutputDir=..\dist
OutputBaseFilename=HarborBrowserSetup-{#AppVersion}{#ReleaseSuffix}
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=admin
ArchitecturesAllowed=x64os
ArchitecturesInstallIn64BitMode=x64os
MinVersion=10.0.16299
CloseApplications=yes
RestartApplications=no
SetupLogging=yes
ChangesAssociations=yes
Uninstallable=yes
VersionInfoCompany={#AppPublisher}
VersionInfoDescription=Harbor Browser Setup
VersionInfoProductName={#AppName}
VersionInfoProductVersion={#AppVersion}
VersionInfoVersion={#AppVersion}.{#BuildRevision}

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Additional shortcuts:"; Flags: unchecked

[Files]
; Application payload generated by Build-Installer.ps1.
Source: "{#PayloadDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

; These prerequisites are embedded in Setup.exe but extracted only when needed.
Source: "{#RedistDir}\ndp48-x86-x64-allos-enu.exe"; Flags: dontcopy
Source: "{#RedistDir}\MicrosoftEdgeWebView2RuntimeInstallerX64.exe"; Flags: dontcopy

Source: "{#PayloadDir}\Branding\HarborBeacon.ico"; DestDir: "{app}\Branding"; DestName: "HarborBeacon-{#AppVersion}.ico"; Flags: ignoreversion

[Icons]
Name: "{group}\Harbor Browser"; Filename: "{app}\{#AppExeName}"; WorkingDir: "{app}"; IconFilename: "{app}\Branding\HarborBeacon-{#AppVersion}.ico"; AppUserModelID: "HarborBrowser.Desktop"
Name: "{autodesktop}\Harbor Browser"; Filename: "{app}\{#AppExeName}"; WorkingDir: "{app}"; IconFilename: "{app}\Branding\HarborBeacon-{#AppVersion}.ico"; AppUserModelID: "HarborBrowser.Desktop"; Tasks: desktopicon

[Run]
Filename: "{app}\{#AppExeName}"; Description: "Launch Harbor Browser"; Flags: postinstall nowait skipifsilent

; Advertise supported associations. Windows keeps the user's default choice.
[Registry]
Root: {#BrowserRegistryRoot}; Subkey: "Software\Clients\StartMenuInternet\{#BrowserClient}"; ValueType: string; ValueData: "{#BrowserRegisteredName}"; Flags: uninsdeletekey
Root: {#BrowserRegistryRoot}; Subkey: "Software\Clients\StartMenuInternet\{#BrowserClient}\DefaultIcon"; ValueType: string; ValueData: """{app}\Branding\HarborBeacon-{#AppVersion}.ico"",0"
Root: {#BrowserRegistryRoot}; Subkey: "Software\Clients\StartMenuInternet\{#BrowserClient}\shell\open\command"; ValueType: string; ValueData: """{app}\{#AppExeName}"""
Root: {#BrowserRegistryRoot}; Subkey: "Software\Clients\StartMenuInternet\{#BrowserClient}\Capabilities"; ValueType: string; ValueName: "ApplicationName"; ValueData: "{#BrowserRegisteredName}"
Root: {#BrowserRegistryRoot}; Subkey: "Software\Clients\StartMenuInternet\{#BrowserClient}\Capabilities"; ValueType: string; ValueName: "ApplicationDescription"; ValueData: "Harbor web browser for HTTP and HTTPS links and local HTML pages."
Root: {#BrowserRegistryRoot}; Subkey: "Software\Clients\StartMenuInternet\{#BrowserClient}\Capabilities"; ValueType: string; ValueName: "ApplicationIcon"; ValueData: """{app}\Branding\HarborBeacon-{#AppVersion}.ico"",0"
Root: {#BrowserRegistryRoot}; Subkey: "Software\Clients\StartMenuInternet\{#BrowserClient}\Capabilities\URLAssociations"; ValueType: string; ValueName: "http"; ValueData: "{#BrowserClient}.URL"
Root: {#BrowserRegistryRoot}; Subkey: "Software\Clients\StartMenuInternet\{#BrowserClient}\Capabilities\URLAssociations"; ValueType: string; ValueName: "https"; ValueData: "{#BrowserClient}.URL"
Root: {#BrowserRegistryRoot}; Subkey: "Software\Clients\StartMenuInternet\{#BrowserClient}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".htm"; ValueData: "{#BrowserClient}.HTML"
Root: {#BrowserRegistryRoot}; Subkey: "Software\Clients\StartMenuInternet\{#BrowserClient}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".html"; ValueData: "{#BrowserClient}.HTML"
Root: {#BrowserRegistryRoot}; Subkey: "Software\Clients\StartMenuInternet\{#BrowserClient}\Capabilities\Startmenu"; ValueType: string; ValueName: "StartMenuInternet"; ValueData: "{#BrowserClient}"
Root: {#BrowserRegistryRoot}; Subkey: "Software\RegisteredApplications"; ValueType: string; ValueName: "{#BrowserRegisteredName}"; ValueData: "Software\Clients\StartMenuInternet\{#BrowserClient}\Capabilities"; Flags: uninsdeletevalue
Root: {#BrowserRegistryRoot}; Subkey: "Software\Classes\{#BrowserClient}.URL"; ValueType: string; ValueData: "Harbor web link"; Flags: uninsdeletekey
Root: {#BrowserRegistryRoot}; Subkey: "Software\Classes\{#BrowserClient}.URL"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""
Root: {#BrowserRegistryRoot}; Subkey: "Software\Classes\{#BrowserClient}.URL\DefaultIcon"; ValueType: string; ValueData: """{app}\Branding\HarborBeacon-{#AppVersion}.ico"",0"
Root: {#BrowserRegistryRoot}; Subkey: "Software\Classes\{#BrowserClient}.URL\shell\open\command"; ValueType: string; ValueData: """{app}\{#AppExeName}"" -- ""%1"""
Root: {#BrowserRegistryRoot}; Subkey: "Software\Classes\{#BrowserClient}.HTML"; ValueType: string; ValueData: "Harbor HTML document"; Flags: uninsdeletekey
Root: {#BrowserRegistryRoot}; Subkey: "Software\Classes\{#BrowserClient}.HTML\DefaultIcon"; ValueType: string; ValueData: """{app}\Branding\HarborBeacon-{#AppVersion}.ico"",0"
Root: {#BrowserRegistryRoot}; Subkey: "Software\Classes\{#BrowserClient}.HTML\shell\open\command"; ValueType: string; ValueData: """{app}\{#AppExeName}"" -- ""%1"""
Root: {#BrowserRegistryRoot}; Subkey: "Software\Classes\.htm\OpenWithProgids"; ValueType: string; ValueName: "{#BrowserClient}.HTML"; ValueData: ""; Flags: uninsdeletevalue uninsdeletekeyifempty
Root: {#BrowserRegistryRoot}; Subkey: "Software\Classes\.html\OpenWithProgids"; ValueType: string; ValueName: "{#BrowserClient}.HTML"; ValueData: ""; Flags: uninsdeletevalue uninsdeletekeyifempty

[Code]
const
  DotNet48ReleaseKey = 'SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full';
  WebView2ClientKey = 'SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}';

var
  PrerequisitesNeedRestart: Boolean;

function NeedRestart: Boolean;
begin
  Result := PrerequisitesNeedRestart;
end;

function IsDotNet48OrLaterInstalled: Boolean;
var
  ReleaseValue: Cardinal;
begin
  ReleaseValue := 0;
  Result := RegQueryDWordValue(HKLM64, DotNet48ReleaseKey, 'Release', ReleaseValue)
    and (ReleaseValue >= 528040);
  Log('.NET release value: ' + IntToStr(ReleaseValue) + '; requirement met: ' + IntToStr(Ord(Result)));
end;

function IsUsableVersion(const VersionText: String): Boolean;
var
  DotPosition, MajorVersion: Integer;
begin
  { Release 0.5.4 is tested with Runtime 157; update older installations
    using the included, signed Evergreen standalone package. }
  DotPosition := Pos('.', VersionText);
  MajorVersion := 0;
  if DotPosition > 1 then
    MajorVersion := StrToIntDef(Copy(VersionText, 1, DotPosition - 1), 0);
  Result := MajorVersion >= 157;
end;

function IsWebView2RuntimeInstalled: Boolean;
var
  VersionText: String;
begin
  Result := False;

  { Microsoft documents the machine-wide x64 runtime key in the 32-bit registry view. }
  if RegQueryStringValue(HKLM32, WebView2ClientKey, 'pv', VersionText) then
  begin
    Log('Machine WebView2 runtime: ' + VersionText);
    if IsUsableVersion(VersionText) then
    begin
      Result := True;
      Exit;
    end;
  end;

  { Also check a per-user runtime installation. }
  if RegQueryStringValue(HKCU, WebView2ClientKey, 'pv', VersionText) then
  begin
    Log('User WebView2 runtime: ' + VersionText);
    if IsUsableVersion(VersionText) then
      Result := True;
  end;
  if not Result then Log('A WebView2 runtime update is required.');
end;

function CopyProfileFile(const DataDir, BackupDir, FileName: String): Boolean;
begin
  Result := True;
  if FileExists(DataDir + '\' + FileName) then
    Result := CopyFile(DataDir + '\' + FileName, BackupDir + '\' + FileName, False);
end;

function BackupExistingProfile: String;
var
  DataDir, BackupRoot, BackupDir, Stamp: String;
  Suffix: Integer;
begin
  Result := '';
  DataDir := ExpandConstant('{localappdata}\HarborBrowser');

  // The profile lives outside the application folder. Keep a separate pre-upgrade
  // snapshot so an interrupted update cannot take the user's bookmarks, settings,
  // or history with it.
  if not FileExists(DataDir + '\settings.json') and
     not FileExists(DataDir + '\bookmarks.json') and
     not FileExists(DataDir + '\history.json') and
     not FileExists(DataDir + '\session.json') then
    Exit;

  BackupRoot := DataDir + '\UpgradeBackups';
  Stamp := GetDateTimeString('yyyymmdd-hhnnss', '-', ':');
  BackupDir := BackupRoot + '\' + Stamp;
  Suffix := 1;
  while DirExists(BackupDir) do
  begin
    BackupDir := BackupRoot + '\' + Stamp + '-' + IntToStr(Suffix);
    Suffix := Suffix + 1;
  end;

  if not ForceDirectories(BackupDir) then
  begin
    Result := 'Harbor could not create a safety backup folder in ' + BackupRoot + '.';
    Exit;
  end;

  if not CopyProfileFile(DataDir, BackupDir, 'settings.json') or
     not CopyProfileFile(DataDir, BackupDir, 'settings.json.bak') or
     not CopyProfileFile(DataDir, BackupDir, 'bookmarks.json') or
     not CopyProfileFile(DataDir, BackupDir, 'bookmarks.json.bak') or
     not CopyProfileFile(DataDir, BackupDir, 'history.json') or
     not CopyProfileFile(DataDir, BackupDir, 'history.json.bak') or
     not CopyProfileFile(DataDir, BackupDir, 'session.json') or
     not CopyProfileFile(DataDir, BackupDir, 'session.json.bak') or
      not CopyProfileFile(DataDir, BackupDir, 'permissions.json') or
      not CopyProfileFile(DataDir, BackupDir, 'permissions.json.bak') or
      not CopyProfileFile(DataDir, BackupDir, 'session-recovery.json') or
      not CopyProfileFile(DataDir, BackupDir, 'session-recovery.json.bak') or
      not CopyProfileFile(DataDir, BackupDir, 'modules.json') or
      not CopyProfileFile(DataDir, BackupDir, 'modules.json.bak') or
      not CopyProfileFile(DataDir, BackupDir, 'module-permissions.json') or
      not CopyProfileFile(DataDir, BackupDir, 'module-permissions.json.bak') or
     not CopyProfileFile(DataDir, BackupDir, 'tor-preview.txt') or
     not CopyProfileFile(DataDir, BackupDir, 'run-state.json') or
     not CopyProfileFile(DataDir, BackupDir, 'data-version.txt') or
     not CopyProfileFile(DataDir, BackupDir, 'data-version.txt.bak') then
  begin
    Result := 'Harbor could not copy all profile files to the safety backup. No application files have been updated.';
    Exit;
  end;
end;

function ExecutePrerequisite(const FileName, Parameters, FriendlyName: String;
  var NeedsRestart: Boolean): String;
var
  ExitCode: Integer;
begin
  Result := '';
  Log('Starting bundled prerequisite: ' + FriendlyName);
  if not Exec(FileName, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ExitCode) then
  begin
    Result := 'Windows could not start the ' + FriendlyName + ' installer.';
    Exit;
  end;

  Log(FriendlyName + ' installer exit code: ' + IntToStr(ExitCode));
  if ExitCode = 0 then
    Exit;

  if ExitCode = 3010 then
  begin
    NeedsRestart := True;
    PrerequisitesNeedRestart := True;
    Log(FriendlyName + ' requested a Windows restart.');
    Exit;
  end;

  Result := FriendlyName + ' installation failed with exit code ' + IntToStr(ExitCode) + '.';
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  PrereqPath: String;
begin
  Result := '';
  NeedsRestart := False;

  if not IsDotNet48OrLaterInstalled then
  begin
    WizardForm.StatusLabel.Caption := 'Installing Microsoft .NET Framework 4.8...';
    ExtractTemporaryFile('ndp48-x86-x64-allos-enu.exe');
    PrereqPath := ExpandConstant('{tmp}\ndp48-x86-x64-allos-enu.exe');
    Result := ExecutePrerequisite(PrereqPath, '/q /norestart', '.NET Framework 4.8', NeedsRestart);
    if Result <> '' then
      Exit;
  end
  else Log('Using existing .NET Framework; bundled installer skipped.');

  if not IsWebView2RuntimeInstalled then
  begin
    WizardForm.StatusLabel.Caption := 'Installing Microsoft Edge WebView2 Runtime...';
    ExtractTemporaryFile('MicrosoftEdgeWebView2RuntimeInstallerX64.exe');
    PrereqPath := ExpandConstant('{tmp}\MicrosoftEdgeWebView2RuntimeInstallerX64.exe');
    Result := ExecutePrerequisite(PrereqPath, '/silent /install', 'Microsoft Edge WebView2 Runtime', NeedsRestart);
    if Result <> '' then
      Exit;
  end
  else Log('Using existing WebView2; bundled installer skipped.');

  WizardForm.StatusLabel.Caption := 'Backing up Harbor profile...';
  Result := BackupExistingProfile;
end;

