{
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "https://harbor-tor-control.invalid/*"
      ],
      "run_at": "document_idle",
      "js": [
        "content.js"
      ]
    }
  ],
  "manifest_version": 3,
  "background": {
    "service_worker": "worker.js"
  },
  "permissions": [
    "proxy",
    "privacy"
  ],
  "version": "0.2.0",
  "name": "Harbor Tor routing"
}
