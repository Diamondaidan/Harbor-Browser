<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HarborBrowser</AssemblyName>
    <Version>0.4.2</Version>
    <AssemblyVersion>0.4.2.0</AssemblyVersion>
    <FileVersion>0.4.2.0</FileVersion>
    <InformationalVersion>0.4.2</InformationalVersion>
    <ApplicationIcon>HarborBrowser.ico</ApplicationIcon>
    <RootNamespace>HarborBrowser</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- WPF markup compilation with the .NET SDK-style project may not resolve
         System.Web transitively from System.Web.Extensions. Reference it explicitly
         to avoid MC1000: Could not find assembly System.Web. -->
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Home\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Resource Include="HarborBrowser.ico"/><Resource Include="Assets\Home\beacon.png"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets\Media\media.js"/><Content Include="Branding\*.ico" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
