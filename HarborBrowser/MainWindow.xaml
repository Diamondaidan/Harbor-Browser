<Window x:Class="HarborBrowser.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="pack://application:,,,/HarborBrowser;component/HarborBrowser.ico" Title="Harbor Browser" Height="850" Width="1320" MinHeight="280" MinWidth="480" WindowStartupLocation="CenterScreen" Background="{DynamicResource HarborWindow}" FontFamily="Segoe UI" FontSize="12.5" WindowStyle="None" ResizeMode="CanResize" StateChanged="Window_StateChanged" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="29" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource HarborText}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HarborHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HarborSelected}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HarborSelected}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#A92318" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="WindowFrame" Background="{DynamicResource HarborWindow}" BorderBrush="{DynamicResource HarborLine}" BorderThickness="1">
    <DockPanel LastChildFill="True">
      <StatusBar x:Name="BottomStatus" DockPanel.Dock="Bottom" Height="25" Background="{DynamicResource HarborWindow}" BorderBrush="{DynamicResource HarborLine}" BorderThickness="0,1,0,0">
        <StatusBarItem>
          <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource HarborMuted}" />
        </StatusBarItem>
        <Separator />
        <StatusBarItem HorizontalAlignment="Right">
          <TextBlock Text="Harbor 0.3.7  •  WebView2" Foreground="{DynamicResource HarborMuted}" />
        </StatusBarItem>
      </StatusBar>
      <Border x:Name="DownloadNotificationBar" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="{DynamicResource HarborPanel}" BorderBrush="{DynamicResource HarborLine}" BorderThickness="0,1,0,0" Padding="12,5">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="DownloadNotificationText" Text="Download started" Foreground="{DynamicResource HarborText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <ProgressBar x:Name="DownloadNotificationProgress" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Height="3" Margin="0,4,0,0" BorderThickness="0" />
        </Grid>
      </Border>
      <!-- Native caption gestures work on the unused space in this compact header. -->
      <!-- Header-only tab strip. WebView content is hosted in BrowserContentHost below. -->
      <!-- Tabs are intentionally above the address/search bar. -->
      <!-- The browser now uses the full content width. Bookmarks, history, downloads,
             and VPN controls are available from the Harbor gear menu. -->
      <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="BrowserChrome" DockPanel.Dock="Top">
        <Border x:Name="TitleBar" Height="38" Background="{DynamicResource HarborPanel}" BorderBrush="{DynamicResource HarborLine}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="118" x:Name="BrandColumn" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="46" x:Name="TitleDragColumn" />
              <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
              <Image x:Name="HeaderBrandLogo" Source="pack://application:,,,/HarborBrowser;component/Assets/Home/beacon.png" Width="24" Height="24" Margin="0,0,7,0" AutomationProperties.Name="Harbor Beacon logo" />
              <TextBlock Text="HARBOR" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" x:Name="HeaderBrandWordmark" />
            </StackPanel>
            <TabControl x:Name="BrowserTabs" Height="34" Background="{DynamicResource HarborPanel}" BorderBrush="{DynamicResource HarborLine}" BorderThickness="0,0,0,1" AllowDrop="True" DragOver="BrowserTabs_DragOver" Drop="BrowserTabs_Drop" DragLeave="BrowserTabs_DragLeave" SelectionChanged="BrowserTabs_SelectionChanged" Grid.Column="1" Margin="1,2,0,2" WindowChrome.IsHitTestVisibleInChrome="True" PreviewMouseLeftButtonDown="TitleTabStrip_MouseDown" PreviewMouseWheel="TitleTabStrip_MouseWheel" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
              <TabControl.Template>
                <ControlTemplate TargetType="{x:Type TabControl}">
                  <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Background="{DynamicResource HarborPanel}" Focusable="False">
                    <StackPanel Orientation="Horizontal" Background="{DynamicResource HarborPanel}">
                      <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Margin="5,2,0,0" Background="Transparent" />
                      <Button Content="＋" Width="29" Height="27" Margin="4,2,7,3" Padding="0" FontSize="16" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" Background="{DynamicResource HarborPanel}" BorderBrush="{DynamicResource HarborLine}" />
                    </StackPanel>
                  </ScrollViewer>
                </ControlTemplate>
              </TabControl.Template>
            </TabControl>
            <Border Grid.Column="2" Background="Transparent" ToolTip="Drag here to move the window; double-click to maximize" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="MinimizeWindowButton" Content="" Style="{StaticResource CaptionButtonStyle}" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="MinimizeWindow_Click" />
              <Button x:Name="MaximizeWindowButton" Content="" Style="{StaticResource CaptionButtonStyle}" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="MaximizeWindow_Click" />
              <Button x:Name="CloseWindowButton" Content="" Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="Close" AutomationProperties.Name="Close" Click="CloseWindow_Click" />
            </StackPanel>
          </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Height="43" Background="{DynamicResource HarborPanel}" BorderBrush="{DynamicResource HarborLine}" BorderThickness="0,0,0,1" Padding="5,3" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="34" x:Name="HomeColumn" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="35" x:Name="BookmarkColumn" />
              <ColumnDefinition Width="46" x:Name="GoColumn" />
              <ColumnDefinition Width="145" x:Name="EngineColumn" />
              <ColumnDefinition Width="35" />
              <ColumnDefinition Width="35" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="◀" ToolTip="Back" Click="Back_Click" Margin="1" />
            <Button Grid.Column="1" Content="▶" ToolTip="Forward" Click="Forward_Click" Margin="1" />
            <Button Grid.Column="2" Content="↻" ToolTip="Reload" Click="Reload_Click" Margin="1" />
            <Button Grid.Column="3" Content="⌂" ToolTip="Home" Click="Home_Click" Margin="1" x:Name="HomeButton" />
            <TextBox x:Name="AddressBox" Grid.Column="4" Margin="4,1,2,1" Padding="8,3" VerticalContentAlignment="Center" ToolTip="Enter a web address or search terms" PreviewKeyDown="AddressBox_KeyDown" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus" MinWidth="120" />
            <Popup x:Name="AddressSuggestions" PlacementTarget="{Binding ElementName=AddressBox}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" Focusable="False">
              <Border Background="{DynamicResource HarborPanel}" BorderBrush="{DynamicResource HarborLine}" BorderThickness="1" CornerRadius="4" Width="{Binding ActualWidth,ElementName=AddressBox}" Padding="3">
                <ListBox x:Name="AddressSuggestionList" Background="Transparent" BorderThickness="0" MaxHeight="270" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" PreviewMouseLeftButtonUp="AddressSuggestion_Click">
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False"/><Setter Property="Padding" Value="7,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SuggestionSurface" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SuggestionSurface" Property="Background" Value="{DynamicResource HarborHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="SuggestionSurface" Property="Background" Value="{DynamicResource HarborSelected}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Url}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource HarborMuted}"/><TextBlock Text="{Binding SourceLabel}" FontSize="10" Foreground="{DynamicResource HarborMuted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Popup>
            <Button x:Name="BookmarkToggleButton" Grid.Column="5" Content="☆" FontSize="20" Padding="0" Margin="1" ToolTip="Bookmark this page" Click="ToggleCurrentBookmark_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource HarborMuted}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
            <Button Grid.Column="6" Content="Go" Click="Go_Click" Margin="2,1" x:Name="GoButton" />
            <ComboBox x:Name="SearchEngineBox" Grid.Column="7" Margin="4,1,1,1" VerticalContentAlignment="Center" SelectedValuePath="Id" SelectionChanged="SearchEngineBox_SelectionChanged" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
            <Button x:Name="GearMenuButton" Grid.Column="9" Content="⚙" FontSize="19" Padding="0" Margin="1" ToolTip="Harbor menu" AutomationProperties.Name="Harbor menu" Background="Transparent" BorderThickness="0" Click="GearMenuButton_Click" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
            <Button xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="PictureInPictureButton" Grid.Column="8" Content="▣" FontSize="19" Padding="0" Margin="1" ToolTip="Picture in picture (Ctrl+Shift+P)" AutomationProperties.Name="Picture in picture" Click="PictureInPicture_Click" />
          </Grid>
        </Border>
        <Border x:Name="BookmarksBar" DockPanel.Dock="Top" Height="31" Background="{DynamicResource HarborPanel}" BorderBrush="{DynamicResource HarborLine}" BorderThickness="0,0,0,1" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="BookmarksBarPanel" Orientation="Horizontal" VerticalAlignment="Center" />
          </ScrollViewer>
        </Border>
      </StackPanel>
      <ContentControl x:Name="BrowserContentHost" Background="{DynamicResource HarborInput}" />
    </DockPanel>
  </Border>
</Window>