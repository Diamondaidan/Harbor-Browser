<Window x:Class="HarborBrowser.Views.ResourceMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Harbor Resource Monitor" Height="580" Width="850" MinHeight="300" MinWidth="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource HarborWindow}" FontFamily="Segoe UI" FontSize="13">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="Harbor Resource Monitor" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock x:Name="IntroHelp" Text="See which tabs are sleeping and what keeps others awake. Memory is measured by process because tabs may share a renderer." Foreground="{DynamicResource HarborMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Refresh now" Width="100" Click="Refresh_Click"/>
      <Button Content="Close" Width="85" Click="Close_Click"/>
    </StackPanel>
    <TabControl x:Name="MonitorTabs" Background="{DynamicResource HarborWindow}">
      <TabItem x:Name="TabsTab" Header="Tabs">
        <DockPanel Margin="5">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="TabHelp" Text="Sleeping preserves the page. Unloading releases its view and reloads the address later, losing page state and Back/Forward history. Enable unloading in Settings to use it here. Keep awake protects a tab until it closes." Foreground="{DynamicResource HarborMuted}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,6,0,0">
              <Button x:Name="ActivateTabButton" Content="Switch to tab" Click="ActivateTab_Click"/>
              <Button x:Name="SleepTabButton" Content="Sleep selected" Click="SleepTab_Click"/>
              <Button x:Name="WakeTabButton" Content="Wake selected" Click="WakeTab_Click"/>
              <Button x:Name="UnloadTabButton" Content="Unload selected" Click="UnloadTab_Click" ToolTip="Checks for unsaved input and media before unloading. Some website state cannot be detected."/>
              <Button x:Name="KeepAwakeButton" Content="Keep awake" Click="KeepAwake_Click"/>
              <Button x:Name="SleepInactiveButton" Content="Sleep inactive tabs" Click="SleepInactive_Click"/>
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="TabGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" SelectionChanged="TabGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tab" Binding="{Binding Title}" Width="2*" MinWidth="100"/>
              <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="2*" MinWidth="130"/>
              <DataGridTextColumn Header="Unloading" Binding="{Binding UnloadState}" Width="2*" MinWidth="130"/>
              <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="65"/>
              <DataGridCheckBoxColumn Header="Keep awake" Binding="{Binding KeepAwake}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="ProcessesTab" Header="Processes">
        <Border Background="{DynamicResource HarborInput}" BorderBrush="{DynamicResource HarborLine}" BorderThickness="1" Padding="10" Margin="5">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="ReportBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"/>
          </ScrollViewer>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
