<Window x:Class="HarborBrowser.Views.ResourceMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Harbor Resource Monitor" Height="520" Width="700" MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Harbor Resource Monitor" FontSize="21" FontWeight="SemiBold" Foreground="#233746" />
            <TextBlock Text="Live process and tab overview. WebView2 renderer memory is reported by process, not attributed to individual tabs." Foreground="#61717D" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Refresh now" Width="100" Margin="0,0,8,0" Click="Refresh_Click" />
            <Button Content="Close" Width="85" Click="Close_Click" />
        </StackPanel>
        <Border Background="White" BorderBrush="#CFD8DF" BorderThickness="1" CornerRadius="5" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="ReportBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Auto" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
