<Window x:Class="HarborBrowser.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HarborBrowser.Views"
        Title="Harbor Settings" Height="720" Width="650"
        MinHeight="470" MinWidth="520" MaxHeight="1000"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F3F6F8" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The settings content scrolls independently of the action buttons. -->
        <views:SmoothScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                                  PanningMode="VerticalOnly" Padding="0,0,9,12">
            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Harbor Settings" FontSize="21" FontWeight="SemiBold" Foreground="#233746" />
                    <TextBlock Text="Choose your browsing defaults and tune Harbor's resource use." Foreground="#61717D" Margin="0,3,0,0" />
                </StackPanel>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Default search engine" VerticalAlignment="Center" />
                    <ComboBox x:Name="SearchEngineBox" Grid.Column="1" Height="30" SelectedValuePath="Id" />
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Home page" VerticalAlignment="Center" />
                    <TextBox x:Name="HomePageBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center" />
                </Grid>

                <GroupBox Header="Interface" Padding="12" BorderBrush="#C6D0D8" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="ShowBookmarksBarBox" Content="Show bookmarks toolbar" Margin="0,3,0,7" />
                        <CheckBox x:Name="ShowStatusBarBox" Content="Show status bar" Margin="0,3,0,7" />
                        <CheckBox x:Name="EnableDevToolsBox" Content="Enable developer tools (advanced)" Margin="0,3,0,2" />
                        <TextBlock Text="When enabled, press F12 or Ctrl+Shift+I to open WebView2 Developer Tools. Inspect page HTML and styles, view JavaScript errors in Console, examine Network requests, and troubleshoot page performance or storage. This is optional and is mainly useful for web development and diagnosing website problems."
                                   Foreground="#61717D" TextWrapping="Wrap" Margin="18,0,0,2" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Performance and memory" Padding="12" BorderBrush="#C6D0D8" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="SuspendInactiveTabsBox" Content="Put inactive tabs to sleep automatically" FontWeight="SemiBold" Margin="0,3,0,10" />
                        <Grid Margin="20,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sleep a tab after" VerticalAlignment="Center" />
                            <ComboBox x:Name="SuspendDelayBox" Grid.Column="1" Height="29" SelectedValuePath="Tag">
                                <ComboBoxItem Content="30 seconds" Tag="30" />
                                <ComboBoxItem Content="1 minute" Tag="60" />
                                <ComboBoxItem Content="2 minutes" Tag="120" />
                                <ComboBoxItem Content="5 minutes" Tag="300" />
                                <ComboBoxItem Content="10 minutes" Tag="600" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="Sleeping tabs pause page scripts and animations to reduce background CPU and memory use. They wake automatically when selected. Some pages with active work may decline suspension. Downloads and open tabs are retained." Foreground="#61717D" TextWrapping="Wrap" Margin="20,0,0,8" />
                        <TextBlock Text="New tabs are already lazy-loaded: the browser engine starts only when you first open a tab." Foreground="#61717D" TextWrapping="Wrap" Margin="20,0,0,2" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Privacy and session" Padding="12" BorderBrush="#C6D0D8" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="RestorePreviousSessionBox" Content="Restore my previous tabs when Harbor starts" Margin="0,3,0,7" />
                        <CheckBox x:Name="EnableTrackerBlockingBox" Content="Block requests to Harbor's known advertising and analytics tracker list" FontWeight="SemiBold" Margin="0,3,0,7" />
                        <Grid Margin="18,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="WebView2 tracking prevention" VerticalAlignment="Center" />
                            <ComboBox x:Name="TrackingPreventionLevelBox" Grid.Column="1" Height="28" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Off" Tag="None" />
                                <ComboBoxItem Content="Basic" Tag="Basic" />
                                <ComboBoxItem Content="Balanced (recommended)" Tag="Balanced" />
                                <ComboBoxItem Content="Strict" Tag="Strict" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="WebView2 tracking prevention applies at the browser-profile level. Strict mode blocks more cross-site tracking but may affect some websites. Changes apply on the next navigation; reload open pages to apply immediately." Foreground="#61717D" TextWrapping="Wrap" Margin="18,0,0,8" />
                        <CheckBox x:Name="ClearCookiesOnExitBox" Content="Clear website cookies when Harbor closes" Margin="0,3,0,7" />
                        <CheckBox x:Name="ClearCacheOnExitBox" Content="Clear cached website files when Harbor closes" Margin="0,3,0,7" />
                        <TextBlock Text="Private tabs use WebView2 InPrivate profiles and are not saved to session restore or Harbor history. Downloads and bookmarks you explicitly create can still remain on this computer." Foreground="#61717D" TextWrapping="Wrap" Margin="18,0,0,2" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </views:SmoothScrollViewer>

        <!-- This footer stays visible even when the content above needs scrolling. -->
        <Border Grid.Row="1" BorderBrush="#D3DCE3" BorderThickness="0,1,0,0" Padding="0,12,0,0" Background="#F3F6F8">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Changes are saved when you select Save settings." Foreground="#71808B"
                           VerticalAlignment="Center" TextWrapping="Wrap" Width="150" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                    <Button Content="Save settings" Width="115" Background="#DCE8F0"
                            IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
