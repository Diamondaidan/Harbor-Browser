<UserControl x:Class="HarborBrowser.Views.DownloadsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource HarborWindow}" FontFamily="Segoe UI" FontSize="13">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock x:Name="PageHeading" Text="Downloads" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Text="Downloads from this browser session. Removing an item keeps its file on your computer." TextWrapping="Wrap" Foreground="{DynamicResource HarborMuted}" Margin="0,5,0,0"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <Grid Width="210" Margin="0,2,10,2">
    <TextBox x:Name="DownloadSearch" TextChanged="Search_Changed" ToolTip="Search downloads by filename" AutomationProperties.Name="Search downloads"/>
    <TextBlock Text="Search downloads" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource HarborMuted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text.Length,ElementName=DownloadSearch}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <Button Content="Open downloads folder" Click="Folder_Click" Margin="0,2,8,2"/>
   <Button Content="Clear completed" Click="Clear_Click" Margin="0,2,0,2"/>
  </WrapPanel>
  <Grid Grid.Row="2">
   <ListBox x:Name="DownloadList" MinHeight="100" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate>
     <Border Background="{DynamicResource HarborPanel}" BorderBrush="{DynamicResource HarborLine}" BorderThickness="1" CornerRadius="6" Padding="14">
      <StackPanel>
       <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
       <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource HarborMuted}" Margin="0,6,0,6" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding RecoveryText}" TextWrapping="Wrap" Margin="0,0,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding RecoveryText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="4" BorderThickness="0"/>
       <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource HarborMuted}" Margin="0,7,0,6" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
       <WrapPanel>
        <Button Content="Open file" Tag="open" Click="Action_Click" IsEnabled="{Binding CanOpen}"/>
        <Button Content="Show in folder" Tag="reveal" Click="Action_Click" IsEnabled="{Binding CanReveal}"/>
        <Button Content="Pause" Tag="pause" Click="Action_Click" IsEnabled="{Binding IsActive}"/>
        <Button Content="Resume" Tag="resume" Click="Action_Click" IsEnabled="{Binding CanRequestResume}" ToolTip="Resume is available only while the browser still has a resumable download operation. Connection changes never resume it automatically."/>
        <Button Content="Cancel" Tag="cancel" Click="Action_Click" IsEnabled="{Binding CanCancel}"/>
        <Button Content="Remove" Tag="remove" Click="Action_Click" IsEnabled="{Binding CanRemove}"/>
       </WrapPanel>
      </StackPanel>
     </Border>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Text="No matching downloads" Foreground="{DynamicResource HarborMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems,ElementName=DownloadList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </Grid>
 </Grid>
 </ScrollViewer>
</UserControl>
