<Window x:Class="HarborBrowser.Views.CookieManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Harbor Cookie Manager" Height="540" Width="820" MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8" FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Cookie Manager" FontSize="21" FontWeight="SemiBold" Foreground="#233746" />
            <TextBlock x:Name="ScopeText" Foreground="#61717D" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="Cookie values are intentionally hidden. Deleting cookies may sign you out of websites." Foreground="#61717D" FontSize="11" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Refresh" Width="85" Margin="0,0,8,0" Click="Refresh_Click" />
            <Button Content="Remove selected" Width="120" Margin="0,0,8,0" Click="RemoveSelected_Click" />
            <Button Content="Clear all cookies" Width="115" Margin="0,0,8,0" Click="ClearAll_Click" />
            <Button Content="Close" Width="80" IsCancel="True" />
        </StackPanel>
        <DataGrid x:Name="CookiesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" HeadersVisibility="Column" Background="White" BorderBrush="#CFD8DF">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="2*" />
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                <DataGridCheckBoxColumn Header="Secure" Binding="{Binding IsSecure}" Width="65" />
                <DataGridCheckBoxColumn Header="HttpOnly" Binding="{Binding IsHttpOnly}" Width="75" />
                <DataGridTextColumn Header="Lifetime" Binding="{Binding Lifetime}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
