<Application x:Class="HarborBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="HarborAccent" Color="#315A78" />
        <SolidColorBrush x:Key="HarborPanel" Color="#EEF2F5" />
        <SolidColorBrush x:Key="HarborLine" Color="#CBD4DC" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Background" Value="#F7F9FB" />
            <Setter Property="BorderBrush" Value="#B9C6D0" />
            <Setter Property="Foreground" Value="#20303C" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="#AEBBC6" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="MinHeight" Value="27" />
        </Style>
    </Application.Resources>
</Application>
