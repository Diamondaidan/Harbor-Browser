<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework><LangVersion>7.3</LangVersion>
  <AssemblyName>HarborUpdateLauncher</AssemblyName><Product>Harbor Browser</Product><Company>Harbor Browser Project</Company>
  <Copyright>Copyright (C) 2026 Harbor Browser contributors</Copyright>
  <HarborVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION.txt').Trim())</HarborVersion>
  <Version>$(HarborVersion)</Version><AssemblyVersion>$(HarborVersion).0</AssemblyVersion>
  <FileVersion>$(HarborVersion).0</FileVersion><InformationalVersion>$(HarborVersion)</InformationalVersion>
  <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  <PlatformTarget>x64</PlatformTarget>
 </PropertyGroup>
 <ItemGroup><Compile Include="..\HarborBrowser\Updates\*.cs" Exclude="..\HarborBrowser\Updates\AssemblyVisibility.cs" Link="Shared\%(Filename)%(Extension)"/><Reference Include="System.Web.Extensions"/><Reference Include="System.Security"/><Reference Include="System.Windows.Forms"/></ItemGroup>
</Project>
